Panels:
  - Class: rviz_common/Displays
    Help Height: 104
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /TF1
        - /TF1/Frames1
        - /Odometry Localization1
        - /AStar Path1
        - /LiDAR Realtime1
        - /Map Cloud (PCD)1
      Splitter Ratio: 0.5
    Tree Height: 618
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Name: Time
    SyncMode: 0
    SyncSource: LiDAR Realtime

Preferences:
  PromptSaveOnExit: true

Toolbars:
  toolButtonStyle: 2

Visualization Manager:
  Class: ""
  Displays:
    # ========================================================================
    # 基础网格
    # ========================================================================
    - Alpha: 0.5
      Cell Size: 1.0
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true

    # ========================================================================
    # TF坐标系树 - 显示所有坐标变换关系
    # ========================================================================
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15.0
      Frames:
        All Enabled: true
        base_link:
          Value: true
        lidar_frame:
          Value: true
        livox_frame:
          Value: true
        map:
          Value: true
        odom:
          Value: true
        pelvis:
          Value: true
      Marker Scale: 1.0
      Name: TF
      Show Arrows: false
      Show Axes: false
      Show Names: false
      Tree:
        map:
          odom:
            base_link:
              pelvis:
                lidar_frame:
                  livox_frame:
                    {}
      Update Interval: 0.0
      Value: true

    # ========================================================================
    # 占用栅格地图 - 用于路径规划
    # 🔧 关键修复: 使用Transient Local确保后启动的节点也能收到地图
    # ========================================================================
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: true
      Name: Map (Occupancy Grid)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Use Timestamp: false
      Value: true

    # ========================================================================
    # PCD点云地图 - 用于NDT定位的参考地图
    # 🔧 关键修复1: Reliability改为Best Effort匹配发布者
    # 🔧 关键修复2: Durability改为Volatile匹配locate_node发布者(VOLATILE)
    #              locate_node在main_ros2.cpp中使用sensor_qos(VOLATILE)发布/points_map
    #              RViz订阅必须用VOLATILE才兼容，否则QoS不匹配导致收不到消息
    # 🔧 关键修复3: 使用Flat Squares样式提升渲染性能
    # ========================================================================
    - Alpha: 0.4
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10.0
        Min Value: -10.0
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0.0
      Enabled: false
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Map Cloud (PCD)
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.05
      Style: Flat Squares
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /points_map
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    # ========================================================================
    # 原始激光雷达点云 - 直接来自 Livox 驱动 (无需初始位姿即可显示)
    # xfer_format=0 → 标准 PointCloud2 格式，RViz 可直接订阅
    # 用途: 判断 LiDAR 是否正常工作，不依赖 locate_node 定位
    # ========================================================================
    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10.0
        Min Value: -10.0
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 0; 255; 0
      Color Transformer: FlatColor
      Decay Time: 0.2
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: LiDAR Raw (live)
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.05
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /livox/lidar
      Use Fixed Frame: true
      Use rainbow: false
      Value: true

    # ========================================================================
    # 配准后的激光雷达点云 - locate_node NDT 配准输出
    # 需要: 1) LiDAR 正常工作  2) 在 RViz 设置 2D Pose Estimate 初始位姿
    # ========================================================================
    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10.0
        Min Value: -10.0
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0.0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: LiDAR Aligned (after init pose)
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 10
      Size (m): 0.1
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /aligned
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    # ========================================================================
    # 机器人定位里程计 - 显示当前位置和姿态
    # 🔧 关键修复1: 话题从/odometry/filtered改为/odometry/map
    # 🔧 关键修复2: Reliability改为Reliable匹配locate_node发布者
    # 🔧 关键修复3: 显示协方差椭圆帮助诊断定位质量
    # ========================================================================
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1.0
          Scale: 1.0
          Value: true
        Position:
          Alpha: 0.3
          Color: 204; 51; 204
          Scale: 1.0
          Value: true
        Value: true
      Enabled: true
      Keep: 100
      Name: Odometry Localization
      Position Tolerance: 0.1
      Shape:
        Alpha: 1.0
        Axes Length: 1.0
        Axes Radius: 0.1
        Color: 255; 25; 0
        Head Length: 0.3
        Head Radius: 0.1
        Shaft Length: 1.0
        Shaft Radius: 0.05
        Value: Arrow
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/map
      Value: true

    # ========================================================================
    # A*全局路径 - 从起点到目标的规划路径
    # 🔧 保持Reliable QoS确保路径完整接收
    # 🔧 使用Billboards线条样式提升可见度
    # ========================================================================
    - Alpha: 1.0
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 25; 255; 0
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.3
      Name: AStar Path
      Offset:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /astar_path
      Value: true

    # ========================================================================
    # DWA局部路径可视化 - 实时避障轨迹
    # 🔧 新增: ROS2版本缺失的关键可视化
    # ========================================================================
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: DWA Path Visualization
      Namespaces:
        {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /dwa_path_visualization
      Value: true
    


    # ==** 20260416 York, before verification real robot
    # ========================================================================
    # DWA当前选中轨迹 - 当前控制周期真正执行的局部轨迹
    # 作用: 与候选轨迹分离显示，快速定位“为何机器人此刻这样走”
    # ========================================================================
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: DWA Selected Path
      Namespaces:
        {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /dwa_selected_path
      Value: true
    
    # ========================================================================
    # 实际行走轨迹(当前任务) - 由 odom 累积生成
    # 设计目标: 每个新任务会清空旧轨迹，只保留当前目标点对应的走行历史
    # ========================================================================
    - Alpha: 1.0
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 165; 0
      Enabled: true
      Head Diameter: 0.15
      Head Length: 0.12
      Length: 0.15
      Line Style: Billboards
      Line Width: 0.18
      Name: Walked Path (Current Task)
      Offset:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Pose Color: 255; 255; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.05
      Shaft Length: 0.08
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /dwa_walked_path
      Value: true
    # ==** 20260416 York, before verification real robot



    # ========================================================================
    # 检测到的障碍物 - DWA点云聚类结果
    # 🔧 新增: 显示障碍物球体标记
    # ========================================================================
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Detected Obstacles
      Namespaces:
        obstacles: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /detected_obstacles
      Value: true

    # ========================================================================
    # DWA过滤点云 - 避障算法使用的点云
    # 🔧 新增: 帮助调试DWA点云处理
    # ========================================================================
    - Class: rviz_default_plugins/Marker
      Enabled: false
      Name: Filtered Points (DWA)
      Namespaces:
        {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /filtered_points
      Value: false

    # ========================================================================
    # 障碍物状态 - DWA是否检测到障碍物
    # 🔧 新增: 状态指示器
    # ========================================================================
    # 注意: Int32消息需要通过日志查看,RViz无直接Display类型
    # 可以通过`ros2 topic echo /obstacle_status`在终端监控

    # ========================================================================
    # 坐标轴参考 - 帮助理解坐标系方向
    # ========================================================================
    - Alpha: 1.0
      Axes Length: 2.0
      Axes Radius: 0.2
      Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 2.0
      Name: Robot Axes
      Radius: 0.2
      Reference Frame: base_link
      Value: true

    - Alpha: 1.0
      Axes Length: 1.0
      Axes Radius: 0.1
      Class: rviz_default_plugins/Axes
      Enabled: false
      Length: 1.0
      Name: LiDAR Axes
      Radius: 0.1
      Reference Frame: lidar_frame
      Value: false

    - Alpha: 1.0
      Axes Length: 3.0
      Axes Radius: 0.1
      Class: rviz_default_plugins/Axes
      Enabled: false
      Length: 3.0
      Name: Odom Axes
      Radius: 0.1
      Reference Frame: odom
      Value: false

  # ==========================================================================
  # 全局选项
  # ==========================================================================
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root

  # ==========================================================================
  # 交互工具
  # ==========================================================================
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    # 🔧 关键修复: 2D Pose Estimate发布到正确的话题
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.0685
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    # 🔧 关键修复: 2D Goal Pose发布到正确的话题(ROS2标准)
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /move_base_simple/goal
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point

  # ==========================================================================
  # 坐标变换
  # ==========================================================================
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true

  # ==========================================================================
  # 视图设置 - 保持ROS1的优秀视角
  # ==========================================================================
  Views:
    Current:
      Class: rviz_default_plugins/XYOrbit
      Distance: 31.43722915649414
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1.0
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 4.15472412109375
        Y: 9.688858032226562
        Z: 0.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.449796438217163
      Target Frame: <Fixed Frame>
      Value: XYOrbit (rviz_default_plugins)
      Yaw: 6.26358699798584
    Saved: ~

# ==============================================================================
# 窗口几何 - 保持ROS1的布局
# ==============================================================================
Window Geometry:
  Displays:
    collapsed: false
  Height: 1016
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1848
  X: 72
  Y: 41
