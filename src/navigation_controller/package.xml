<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navigation_controller</name>
  <version>0.0.0</version>
  <description>Navigation controller package for G1 robot - ROS2 Humble</description>

  <maintainer email="1347893477@qq.com">szm88</maintainer>
  <license>TODO</license>

  <!-- Build tool dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- C++ dependencies -->
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>robot_localization</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>

  <!-- Python dependencies -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  
  <!-- Robot interfaces (action definitions) -->
  <depend>robot_interfaces</depend>
  
  <!-- Python package dependencies -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-transforms3d</exec_depend>
  
  <!-- Execution dependencies -->
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>

  <!-- Testing dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

  <!-- Member of group to support interface generation -->
  <member_of_group>rosidl_interface_packages</member_of_group>
</package>
