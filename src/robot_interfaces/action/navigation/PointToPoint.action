# ============================================================================
# PointToPoint.action - G1 机器人点对点导航 Action 接口
# ============================================================================
# 功能: 控制 G1 Unitree 机器人从当前位置导航到目标位置
# 协议版本: Navigation_Control_Protocol_v1.0
# ROS2 版本: Humble
# 作者: G1 Navigation Team
# 日期: 2025-11-05
#
# 安全特性:
# - 实时障碍物监控与避让
# - 定位置信度持续监控
# - 紧急停止机制
# - 任务抢占支持
# - 超时保护
#
# 使用场景:
# - MCB (主控板) 向 SLAM 包发送导航任务
# - 支持多任务管理 (通过 task_id 追踪)
# - 提供实时反馈用于上层决策
# ============================================================================

# ============================================================================
# GOAL - 导航任务目标
# ============================================================================
# MCB 发送的目标位置和任务标识

# ---------- 任务标识 ----------
string task_id
# MCB 任务唯一标识符
# 用途: 日志追踪、任务管理、并发控制
# 格式建议: "MCB_TASK_YYYYMMDD_HHMMSS_XXX"
# 示例: "MCB_TASK_20251105_143022_001"

# ---------- 目标位姿 ----------
geometry_msgs/PoseStamped target_pose
# 目标位置和朝向
# - header.frame_id: 必须为 "map" (全局坐标系)
# - header.stamp: 目标设定时间戳
# - pose.position: 目标位置 (x, y, z) [单位: 米]
# - pose.orientation: 目标朝向 (四元数)
#
# 注意事项:
# 1. z 坐标通常为 0 (2D 平面导航)
# 2. orientation 可设为单位四元数 (0,0,0,1) 表示不关心朝向
# 3. 坐标必须在地图有效范围内
# 4. 避免设置在已知障碍物上

---

# ============================================================================
# RESULT - 导航任务执行结果
# ============================================================================
# 任务完成后返回的最终状态

# ---------- 执行结果 ----------
string result          # 执行结果: "success"(成功) 或 "failed"(失败)
# 任务是否成功完成
# "success":  机器人到达目标位置 (误差 < goal_tolerance)
# "failed": 任务失败 (见 status_code 获取失败原因)

# ---------- 状态码 ----------
uint8 status_code
# 详细的任务完成状态码

# 状态码定义:
uint8 STATUS_SUCCESS = 0
# 成功到达目标位置
# - position_error < goal_tolerance (默认 0.3m)
# - 机器人已停止 (速度 < 0.01 m/s)

uint8 STATUS_TIMEOUT = 1
# 任务超时
# - 执行时间超过预设限制 (建议: 距离*3秒 + 60秒基础时间)
# - 可能原因: 路径过长、频繁避障、卡住

uint8 STATUS_LOCALIZATION_LOST = 2
# 定位丢失
# - mid360_locate 置信度持续 < 0.3 超过 5 秒
# - TF 树断开或延迟 > 1 秒
# - 需要重新初始化定位

uint8 STATUS_PATH_BLOCKED = 3
# 路径被阻挡
# - A* 规划器无法找到有效路径
# - DWA 局部规划器长期卡住 (> 10 秒无进展)
# - 障碍物完全封锁路径

uint8 STATUS_GOAL_UNREACHABLE = 4
# 目标点不可达
# - 目标点位于障碍物内部
# - 目标点不在地图有效区域
# - 目标点与机器人距离过远 (> 50m)

uint8 STATUS_PREEMPTED = 5
# 任务被抢占
# - 收到新的导航目标
# - MCB 主动取消任务
# - 优先级更高的任务插入

uint8 STATUS_EMERGENCY_STOP = 6
# 紧急停止
# - 收到紧急停止信号 (/emergency_stop topic)
# - 安全传感器触发 (如碰撞检测)
# - 系统异常保护

# ---------- 最终状态 ----------
geometry_msgs/PoseStamped final_pose
# 任务结束时机器人的实际位姿
# - 来源: /odometry/map 的最后一次更新
# - 用于评估导航精度
# - 失败时可用于恢复或重新规划

float32 position_error
# 最终位置与目标位置的欧几里得距离 [单位: 米]
# 计算方式: sqrt((x_final - x_target)^2 + (y_final - y_target)^2)
# 
# 精度评估:
# - Excellent: < 0.1m
# - Good:      0.1m - 0.3m
# - Acceptable: 0.3m - 0.5m
# - Poor:      > 0.5m

---

# ============================================================================
# FEEDBACK - 导航任务实时反馈
# ============================================================================
# 任务执行过程中周期性发送的状态更新 (建议频率: 5Hz)

# ---------- 当前位姿 ----------
geometry_msgs/PoseStamped current_pose
# 机器人当前位置和朝向
# 来源: /odometry/map (来自 mid360_locate 定位节点)
# 更新频率: 10Hz (跟随里程计更新)

geometry_msgs/Twist current_velocity
# 机器人当前速度
# - linear.x: 前向速度 [m/s]
# - linear.y: 侧向速度 [m/s] (对于差分机器人通常为 0)
# - angular.z: 转向角速度 [rad/s]

# ---------- 导航状态 ----------
uint8 navigation_state
# 当前导航子系统状态

# 导航状态定义:
uint8 STATE_PLANNING = 0
# A* 全局规划中
# - 正在计算从当前位置到目标的最优路径
# - 通常发生在任务启动或重新规划时
# - 持续时间: < 1 秒 (正常情况)

uint8 STATE_FOLLOWING = 1
# 正常路径跟踪
# - 沿 A* 规划的全局路径前进
# - 无障碍物干扰
# - DWA 局部规划器输出稳定速度指令

uint8 STATE_AVOIDING = 2
# DWA 动态避障激活
# - 检测到障碍物 (距离 < 1.5m)
# - DWA 规划器调整局部路径避让
# - 速度可能降低以确保安全

uint8 STATE_RECOVERING = 3
# 恢复行为中
# - 机器人陷入局部困境 (如死角、狭窄通道)
# - 执行后退、旋转等恢复动作
# - 尝试脱离困境区域

uint8 STATE_STUCK = 4
# 可能卡住
# - 位置长期无变化 (> 5 秒移动 < 0.1m)
# - 速度指令发出但机器人不动
# - 可能需要人工干预

# ---------- 障碍物接近度 ----------
uint8 obstacle_proximity
# 最近障碍物距离等级

# 障碍物接近度定义:
uint8 OBSTACLE_CLEAR = 0
# 安全距离
# - 最近障碍物距离 > 1.5m
# - 无需减速
# - 可以全速前进

uint8 OBSTACLE_NEAR = 1
# 接近障碍物
# - 最近障碍物距离 0.5m - 1.5m
# - DWA 开始调整路径
# - 可能降速至 50%-80% 最大速度

uint8 OBSTACLE_CRITICAL = 2
# 危险距离
# - 最近障碍物距离 < 0.5m
# - 大幅降速或紧急制动
# - 可能触发恢复行为

# ---------- 进度信息 ----------
float32 distance_to_goal
# 到目标点的直线距离 [单位: 米]
# 用于估算剩余时间和任务进度

float32 path_length_remaining
# 沿规划路径的剩余长度 [单位: 米]
# 比直线距离更准确 (考虑了转弯和避障)
# 如果路径未生成则等于 distance_to_goal

float32 estimated_time_remaining
# 预计剩余时间 [单位: 秒]
# 估算方式: path_length_remaining / average_velocity
# 考虑了障碍物避让和速度限制

# ---------- 系统健康度 ----------
float32 localization_confidence
# 定位置信度 [范围: 0.0 - 1.0]
# 来源: mid360_locate 点云配准适应度分数
# 
# 置信度评估:
# - Excellent: > 0.7 (精确定位)
# - Good:      0.5 - 0.7 (正常跟踪)
# - Warning:   0.3 - 0.5 (定位不稳定)
# - Critical:  < 0.3 (定位可能丢失,应停止导航)

# ---------- 调试信息 ----------
string debug_message
# 人类可读的调试信息
# 示例:
# - "Following path, 15.2m to goal"
# - "Avoiding obstacle at 0.8m ahead"
# - "Replanning due to blocked path"
# - "Localization confidence low: 0.28"
